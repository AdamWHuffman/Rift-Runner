# --- App ---
ENVIRONMENT=local
ALLOW_SIGNUP=false
# Comma-separated. Add your LAN IP's origin here (e.g. http://10.7.0.109:5173)
# so other devices on your home network can log in.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# The frontend's JS talks to the API on the same hostname the page was
# loaded from (just port 8000 instead of 5173) -- this keeps the
# refresh-token cookie same-site regardless of whether you access the app
# via localhost or a LAN IP, so leave this unset. Only set VITE_API_BASE_URL
# if you genuinely need to point the frontend at a different host/port.
# VITE_API_BASE_URL=http://localhost:8000

# --- Database ---
POSTGRES_USER=quest
POSTGRES_PASSWORD=quest
POSTGRES_DB=quest_for_health
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quest:quest@postgres:5432/quest_for_health

# --- Redis / background jobs ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Garmin credential encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_TOKEN_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# --- Weather lookups (Open-Meteo needs no key, kept here for future providers) ---
WEATHER_LOOKUP_TIMEOUT_SECONDS=5
